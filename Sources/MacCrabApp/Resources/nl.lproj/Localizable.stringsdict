			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld scanner · v%2$@ · %3$@</string>
			<key>other</key>
			<string>%1$lld scanners · v%2$@ · %3$@</string>
		</dict>
	</dict>
