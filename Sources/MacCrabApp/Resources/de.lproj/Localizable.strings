"ui.final.lifecycle1.title" = "Lebenszyklus der Engine-Wartung eingeschränkt";
"ui.final.lifecycle1.workLabel" = "Wartungstimer";
"ui.final.lifecycle2.impact" = "Der unabhängige Lebenszeichen-Schreiber verlor Arbeit, wurde nicht sauber abgeschlossen oder meldete unvollständige Bilanzen. Externe Beobachtungen des Prozesszustands können daher unvollständig sein.";
"ui.final.lifecycle2.title" = "Lebenszyklus des Lebenszeichen-Schreibers eingeschränkt";
"ui.final.lifecycle2.workLabel" = "Lebenszeichen";
"ui.final.lifecycle3.impact" = "Eine Startzustandswiederherstellung oder ein langfristiger Start-Worker ging verloren, wurde nicht sauber abgeschlossen oder meldete unvollständige Bilanzen. Prüfen Sie die genannten Zähler, bevor Sie von vollständigen Startfunktionen ausgehen.";
"ui.final.lifecycle3.title" = "Lebenszyklus der Startaufgaben eingeschränkt";
"ui.final.lifecycle3.workLabel" = "Start-Worker";
"ui.final.lifecycle4.impact" = "Eine Sicherheitsentscheidung wurde nach Annahmeschluss abgelehnt, verworfen, nicht abgewartet oder konnte nicht vollständig bilanziert werden. Einige abgeleitete Erkennungen können fehlen; verlustfreie direkte Ausführung bei Überlast und beabsichtigtes Zusammenführen zählen nicht als Verlust.";
"ui.final.lifecycle4.title" = "Schutz eingeschränkt — Erkennungsarbeit verloren";
"ui.final.lifecycle4.workLabel" = "Erkennungsaufgabe";
"ui.final.lifecycle5.impact" = "Optionale modellgestützte Erklärungen oder Anreicherungen haben Arbeit verworfen oder unvollständige Zuständigkeit gemeldet. Deterministische Erkennung und lokal gespeicherte Warnungen laufen weiter.";
"ui.final.lifecycle5.title" = "KI-Beratungsfunktionen eingeschränkt";
"ui.final.lifecycle5.workLabel" = "Beratungsaufgabe";
"ui.final.lifecycle6.impact" = "Eine Benachrichtigung, ein Webhook, Syslog oder eine zusätzliche Ausgabe wurde möglicherweise nicht zugestellt oder vollständig bilanziert. Erkennung und lokale Warnungsspeicherung laufen weiter.";
"ui.final.lifecycle6.title" = "Warnungszustellung eingeschränkt";
"ui.final.lifecycle6.workLabel" = "Ausgabeaufgabe";
"ui.final.lifecycle7.impact" = "Diese ältere Engine meldet nur eine zusammengefasste Verarbeitungsspur. MacCrab kann daher Erkennungsverluste nicht von Beratungs- oder Zustellungsverlusten unterscheiden. Für eine genaue Zuordnung aktualisieren.";
"ui.final.lifecycle7.title" = "Lebenszyklus älterer abgeleiteter Arbeit eingeschränkt";
