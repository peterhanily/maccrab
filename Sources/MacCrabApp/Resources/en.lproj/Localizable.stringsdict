<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>findings.findingCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld finding</string>
			<key>other</key>
			<string>%1$lld findings</string>
		</dict>
	</dict>
	<key>findings.skippedNote</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld scan couldn't be read and was skipped. Open it from the Scans tab to see why.</string>
			<key>other</key>
			<string>%1$lld scans couldn't be read and were skipped. Open them from the Scans tab to see why.</string>
		</dict>
	</dict>
	<key>kit.footerSummary</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld scanner · v%2$@ · %3$@</string>
			<key>other</key>
			<string>%1$lld scanners · v%2$@ · %3$@</string>
		</dict>
	</dict>
	<key>overview.crab.quipCritical</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>MacCrab is alarmed! %1$lld active critical campaign.</string>
			<key>other</key>
			<string>MacCrab is alarmed! %1$lld active critical campaigns.</string>
		</dict>
	</dict>
	<key>pastScans.bulkDeleteConfirm</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Delete %1$lld scan</string>
			<key>other</key>
			<string>Delete %1$lld scans</string>
		</dict>
	</dict>
	<key>pastScans.bulkDeleteTitle</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Delete %1$lld scan permanently?</string>
			<key>other</key>
			<string>Delete %1$lld scans permanently?</string>
		</dict>
	</dict>
	<key>pastScans.bulkDeletedToast</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Deleted %1$lld scan · freed %2$@.</string>
			<key>other</key>
			<string>Deleted %1$lld scans · freed %2$@.</string>
		</dict>
	</dict>
	<key>scans.rowsCollected</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>· %1$lld row collected so far</string>
			<key>other</key>
			<string>· %1$lld rows collected so far</string>
		</dict>
	</dict>
	<key>scans.scannersDidntRun</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld scanner didn't run:</string>
			<key>other</key>
			<string>%1$lld scanners didn't run:</string>
		</dict>
	</dict>
</dict>
</plist>
