<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>findings.findingCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%1$lld wyniki</string>
			<key>many</key>
			<string>%1$lld wyników</string>
			<key>one</key>
			<string>%1$lld wynik</string>
			<key>other</key>
			<string>%1$lld wyniku</string>
		</dict>
	</dict>
	<key>findings.skippedNote</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Nie można odczytać %1$lld skanowań i zostały one pominięte. Otwórz je na karcie Skanowania, aby poznać przyczynę.</string>
			<key>many</key>
			<string>Nie można odczytać %1$lld skanowań i zostały one pominięte. Otwórz je na karcie Skanowania, aby poznać przyczynę.</string>
			<key>one</key>
			<string>Nie można odczytać %1$lld skanowania i zostało ono pominięte. Otwórz je na karcie Skanowania, aby poznać przyczynę.</string>
			<key>other</key>
			<string>Nie można odczytać %1$lld skanowania i zostało ono pominięte. Otwórz je na karcie Skanowania, aby poznać przyczynę.</string>
		</dict>
	</dict>
