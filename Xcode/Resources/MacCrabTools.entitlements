<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- maccrabctl and maccrab-mcp need only the shared LLM-secret group.
	     Never reuse MacCrabApp.entitlements here: that would leak the
	     system-extension.install capability into command-line tools. -->
	<key>keychain-access-groups</key>
	<array>
		<string>79S425CW99.com.maccrab.shared</string>
	</array>
</dict>
</plist>
